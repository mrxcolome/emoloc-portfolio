# Redireccions canòniques: tot cap a https://emoloc.com (sense www)
RewriteEngine On

# 1) www -> sense www (no s'aplica mentre la web viu a /test/)
RewriteCond %{HTTP_HOST} ^www\.emoloc\.com$ [NC]
RewriteCond %{REQUEST_URI} !^/test/
RewriteRule ^ https://emoloc.com%{REQUEST_URI} [L,R=301]

# 2) http -> https (condicions dobles per evitar bucles darrere del proxy/caché de Webempresa)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://emoloc.com%{REQUEST_URI} [L,R=301]

# Pàgina 404 pròpia
ErrorDocument 404 /404.html

# Mentre la web és de prova a /test/, que els cercadors no la indexin
SetEnvIf Request_URI ^/test/ NOINDEX
<IfModule mod_headers.c>
Header set X-Robots-Tag "noindex, nofollow" env=NOINDEX
</IfModule>

# Tipus i compressió
AddType image/svg+xml .svg
AddType video/mp4 .mp4
AddType image/webp .webp
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# Caché: mitjans i llibreries llargs, HTML curt
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType video/mp4 "access plus 30 days"
ExpiresByType application/javascript "access plus 7 days"
ExpiresByType text/html "access plus 10 minutes"
</IfModule>

# robots.txt fresc
<IfModule mod_headers.c>
<Files "robots.txt">
Header always set Cache-Control "max-age=3600"
Header always unset Expires
</Files>
</IfModule>
